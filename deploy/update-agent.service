[Unit]
Description=Recurdream Docker update agent
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__UPDATE_AGENT_USER__
Group=__UPDATE_AGENT_GROUP__
EnvironmentFile=/etc/recurdream/update-agent.env
ExecStart=/usr/local/libexec/recurdream-update-agent
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=__UPDATE_AGENT_DEPLOY_PATH__ __UPDATE_AGENT_SOCKET_DIR__ __UPDATE_AGENT_LOG_DIR__

[Install]
WantedBy=multi-user.target
